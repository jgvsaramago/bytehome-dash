# /etc/bytehomedash.env — the kiosk's settings and secrets (root, mode 600,
# never in git). setup.sh installs this template when the file is missing.
# Uncomment each line you use and fill it in (an empty value counts as set),
# then restart the app: sudo systemctl restart bytehomedash
# See device/README.md, "Secrets and intercom pieces".

# Home Assistant: the URL and a long-lived access token (HA profile page).
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=

# MQTT (HA's broker): the screen's sensors and controls in HA.
# MQTT_HOST=homeassistant.local
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Intercom (optional — leave these out for a screen without one).
# Hikvision door station (video, opening the door).
# DOOR_HOST=192.168.100.1
# DOOR_USER=admin
# DOOR_PASSWORD=

# Hikvision indoor station (call state, through the HCNetSDK).
# INDOOR_HOST=192.168.100.2
# INDOOR_USER=admin
# INDOOR_PASSWORD=

# SIP extension on the indoor station (receiving door calls, talking).
# SIP_PASSWORD is the indoor station's admin password.
# SIP_SERVER=192.168.100.2
# SIP_NUMBER=           # the extension number the indoor station provisioned
# SIP_PASSWORD=

# Optional:

# SCREEN_NAME=Entrada        # how this screen appears in HA (default: hostname)
# HIK_SDK_DIR=/opt/hcnetsdk
# SIP_SERVER_PORT=5065
# SIP_LOCAL_PORT=5060
# DOOR_PORT=  DOOR_CHANNEL=  DOOR_NO=  INDOOR_PORT=8000
